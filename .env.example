# ──────────────────────────────────────────────────────────────────────────────
# Supabase Configuration
# Get these from https://supabase.com/dashboard/project/_/settings/api
# ──────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ──────────────────────────────────────────────────────────────────────────────
# Claude API Key (for AI workout generation — Supabase Edge Function secret)
# Get your key from https://console.anthropic.com/
# ──────────────────────────────────────────────────────────────────────────────
# CLAUDE_API_KEY=sk-ant-...

# ──────────────────────────────────────────────────────────────────────────────
# Supabase service role key (Edge Functions only — NEVER expose to frontend)
# Get from https://supabase.com/dashboard/project/_/settings/api
# ──────────────────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ──────────────────────────────────────────────────────────────────────────────
# Stripe Price ID for the subscription plan (from Stripe Dashboard → Products)
# Format: price_xxxxxxxxxxxxxxxxxxxxxxxx
# ──────────────────────────────────────────────────────────────────────────────
VITE_STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
